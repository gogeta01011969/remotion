GROQCLOUD_API_KEY=your-groqcloud-key

# Optional model overrides. Comparison research uses bounded local retrieval and plain JSON.
# The older general-purpose generate command still uses browser_search.
GROQ_RESEARCH_MODEL=openai/gpt-oss-120b
GROQ_SCRIPT_MODEL=openai/gpt-oss-120b
GROQ_MOTION_MODEL=openai/gpt-oss-120b

# Cloudflare image provider. CI can supply these directly as environment variables.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-api-token

# Optional local CPU cutout Python (Linux workflow sets this to python).
# BACKGROUND_REMOVAL_PYTHON=/absolute/path/to/project/.venv/bin/python
# Optional render concurrency (1-8); Linux workflows use 2.
# RENDER_CONCURRENCY=2

# One-time setup: npm run youtube:auth -- --client .automation/youtube-client.json
# The helper saves these four values to .env.local without printing tokens.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_CHANNEL_ID=UC...
# Uploads are private unless explicitly changed. GitHub uses repository variables.
# YOUTUBE_PRIVACY_STATUS=private
# YOUTUBE_MADE_FOR_KIDS=false
# YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=true
