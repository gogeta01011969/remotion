GROQCLOUD_API_KEY=your-groqcloud-key

# Optional model overrides. The research model must support browser_search.
GROQ_RESEARCH_MODEL=openai/gpt-oss-120b
GROQ_SCRIPT_MODEL=openai/gpt-oss-120b
GROQ_MOTION_MODEL=openai/gpt-oss-120b

# Cloudflare image provider. CI can supply these directly as environment variables.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-api-token

# Optional local CPU cutout Python (Linux workflow sets this to python).
# BACKGROUND_REMOVAL_PYTHON=/absolute/path/to/project/.venv/bin/python
# Optional render concurrency (1-8); Linux workflows use 2.
# RENDER_CONCURRENCY=2
